document.getElementById("envio").addEventListener("change",calcularTotalFinal);
document.getElementById("formaPago").addEventListener("change",mostrarPago);
document.getElementById("plazo").addEventListener("change",calcularMensualidad);

// INICIALIZACIÓN
mostrarCatalogo();
mostrarCatalogoCompra();
mostrarRecomendaciones();
mostrarDestacados();
mostrarAutores();
actualizarCarrito();
mostrarPago();
cargarTasasCambio();

const inicial=location.hash.slice(1);
if(inicial&&document.getElementById(inicial)?.classList.contains("pagina"))irA(inicial);
