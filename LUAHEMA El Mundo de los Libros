// DESCARGAR TICKET
function descargarTicket(){
 const elemento=document.querySelector("#ticketCompra .ticket");
 if(!elemento){alert("No hay un ticket para descargar.");return}
 const estilos=Array.from(document.querySelectorAll("style")).map(s=>s.innerHTML).join("\n");
 const documento=`<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>Ticket LUAHEMA</title><style>${estilos}</style></head><body>${elemento.outerHTML}</body></html>`;
 const archivo=new Blob([documento],{type:"text/html;charset=utf-8"});
 const url=URL.createObjectURL(archivo);
 const enlace=document.createElement("a");
 enlace.href=url;
 enlace.download="Ticket-LUAHEMA.html";
 document.body.appendChild(enlace);
 enlace.click();
 enlace.remove();
 setTimeout(()=>URL.revokeObjectURL(url),1500);
}

// NUEVA COMPRA
function nuevaCompra(){
 carrito=[];
 actualizarCarrito();
 document.getElementById("formPedido").reset();
 document.getElementById("ticketCompra").innerHTML="";
 document.getElementById("ticketCompra").style.display="none";
 document.getElementById("formularioCompra").style.display="none";
 monedaSeleccionada="MXN";
 document.getElementById("moneda").value="MXN";
 document.getElementById("monedaCheckout").value="MXN";
 actualizarPrecios();
 mostrarPago();
 irA("comprar");
}

// CANCELAR
function cancelarCompra(){
 if(confirm("¿Quieres cancelar el formulario de compra?")){
  document.getElementById("formularioCompra").style.display="none";
  document.getElementById("formPedido").reset();
  mostrarPago();
  calcularTotalFinal();
 }
}

// EVENTOS
document.getElementById("formPedido").addEventListener("submit",function(e){
 e.preventDefault();
 e.stopPropagation();

 if(!validarFormulario())return;

 // Generar el ticket directamente después de validar.
 generarTicket();
});

document.getElementById("busqueda").addEventListener("input",mostrarCatalogo);
document.getElementById("filtroGenero").addEventListener("change",mostrarCatalogo);
document.getElementById("moneda").addEventListener("change",cambiarMoneda);
